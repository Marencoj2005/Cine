@page "/empleados"
@inject IHttpClientFactory ClientFactory
@using System.Net.Http.Json

<h3>Lista de Empleados</h3>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Salario</th>
            </tr>
        </thead>
        <tbody>
            @if (cargando)
            {
                <tr><td colspan="4" class="text-center">Cargando empleados...</td></tr>
            }
            else if (empleadosEncontrados == null || !empleadosEncontrados.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">No hay empleados registrados.</td></tr>
            }
            else
            {
                @foreach (var emp in empleadosEncontrados)
                {
                    <tr>
                        <td>@emp.CodEmpleado</td>
                        <td>@emp.Nombre</td>
                        <td>@emp.Apellido</td>
                        <td>@emp.Salario?.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<EmpleadoDto>? empleadosEncontrados;
    private bool cargando = true;
    private string? error = null;

    // OnInitializedAsync se ejecuta automáticamente cuando la página carga
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("CineAPI");

            // Hacemos la petición directamente sin parámetros
            empleadosEncontrados = await client.GetFromJsonAsync<List<EmpleadoDto>>("api/empleados");
        }
        catch (Exception ex)
        {
            error = "Error al conectar con la API: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    public class EmpleadoDto
    {
        public int CodEmpleado { get; set; }
        public string? Nombre { get; set; }
        public string? Apellido { get; set; }
        public double? Salario { get; set; }
    }
}